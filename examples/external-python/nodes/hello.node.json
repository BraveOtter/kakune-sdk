{
  "apiVersion": "kakune.dev/v1",
  "kind": "NodeDefinition",
  "type": "kakune.python-hello@1",
  "name": "Python Hello",
  "description": "Returns a greeting from a standard-library Python process.",
  "inputSchema": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": { "type": "string", "minLength": 1 }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "message": { "type": "string" }
    }
  }
}
