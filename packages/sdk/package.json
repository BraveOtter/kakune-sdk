{
  "name": "@kakune/sdk",
  "version": "0.1.0",
  "description": "High-level TypeScript SDK for Kakune.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@kakune/client": "workspace:^",
    "@kakune/contracts": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
