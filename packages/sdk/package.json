{
  "name": "@kakune-ai/sdk",
  "version": "0.1.0",
  "description": "High-level TypeScript SDK for Kakune.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraveOtter/kakune-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@kakune-ai/client": "workspace:^",
    "@kakune-ai/contracts": "workspace:^"
  },
  "publishConfig": {
    "dependencies": {
      "@kakune-ai/client": "^0.1.0",
      "@kakune-ai/contracts": "^0.1.0"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
