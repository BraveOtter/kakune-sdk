{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kakune.dev/schemas/plugin-manifest.schema.json",
  "title": "Kakune Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "entrypoint"],
  "properties": {
    "apiVersion": { "const": "kakune.dev/v1" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^@[a-z0-9-]+/[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "maxLength": 280 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "type": "string", "pattern": "^\\./[^\\\\]+$" },
        "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
