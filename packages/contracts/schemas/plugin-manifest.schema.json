{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kakune.dev/schemas/plugin-manifest.schema.json",
  "title": "Kakune Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "version", "pluginProtocol", "runtime"],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"
    },
    "name": { "type": "string", "pattern": "\\S" },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "pluginProtocol": { "const": ">=1.0.0 <2.0.0" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": { "const": "process" },
        "command": { "type": "string", "pattern": "^[^\\u0000]+$" },
        "args": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^\\u0000]+$" }
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "\\S" }
      }
    },
    "description": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "\\S" }
    },
    "license": { "type": "string" },
    "model": { "type": "string" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "versionArgs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!\\\\)(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
          }
        },
        "triggers": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "array", "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "process": { "type": "array", "items": { "type": "string", "maxLength": 512, "pattern": "\\S" } },
        "filesystem": { "type": "array", "items": { "type": "string", "maxLength": 512, "pattern": "\\S" } },
        "network": { "type": "array", "items": { "type": "string", "maxLength": 512, "pattern": "\\S" } },
        "secrets": { "type": "array", "items": { "type": "string", "maxLength": 512, "pattern": "\\S" } }
      }
    }
  }
}
