{
  "apiVersion": "kakune/v1",
  "kind": "Workflow",
  "metadata": {
    "id": "nightly-report",
    "name": "Nightly report",
    "labels": { "team": "platform" }
  },
  "inputs": { "type": "object" },
  "triggers": [{ "id": "manual", "type": "kakune.trigger.manual@1" }],
  "entry": "build-report",
  "nodes": [{ "id": "build-report", "type": "kakune.report.build@1", "with": { "format": "json" } }],
  "policy": { "concurrency": { "maxRuns": 1, "overflow": "queue", "maxQueued": 10 } },
  "layout": { "nodes": { "build-report": { "x": 80, "y": 120 } } }
}
