{
  "name": "kakune-sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Kakune contracts, client, SDK, and plugin creator.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "ajv": "^8.17.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
